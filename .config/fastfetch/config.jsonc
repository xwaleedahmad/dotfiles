{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "type": "small",
    "color": {
      "1": "38;2;180;190;254", // #B4BEFE
      "2": "38;2;180;190;254" // #B4BEFE
    },
    "padding": {
      "left": 4,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;180;190;254", // #B4BEFE
      "title": "38;2;180;190;254" // #B4BEFE
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "╭─{icon} OS"
    },
    {
      "type": "wm",
      "key": "├─ WM"
    },
    {
      "type": "de",
      "key": "├─ DE"
    },
    {
      "type": "lm",
      "key": "├─󰧨 LM"
    },
    {
      "type": "shell",
      "key": "├─ Shell"
    },
    {
      "type": "terminal",
      "key": "├─ Terminal",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "├─ Kernel"
    },
    {
      "type": "uptime",
      "key": "└─󰅐 Start Time"
    },
    // {
