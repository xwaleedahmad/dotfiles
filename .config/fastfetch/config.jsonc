{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logos/arch.txt",
    "type": "file",
    "color": {
      "1": "#b4befe",
      "2": "#b4befe"
    },
    "padding": {
      "left": 4,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#b4befe",
      "title": "#b4befe"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "{icon} OS",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": " TM",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": " WM",
      "format": "{pretty-name}"
    },
    {
      "type": "lm",
      "key": "󰧨 LM",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": " SH",
      "format": "{pretty-name}"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "brightness": "normal"
    }
  ]
}
